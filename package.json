{
  "name": "@flyo/nitro-next-workspace",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "./lib",
    "./playground"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@flyo/nitro-next",
    "build": "npm run build --workspace=@flyo/nitro-next",
    "playground": "npm run dev --workspace=@flyo/nitro-next-playground",
    "ci-test": "npm run test --workspace=@flyo/nitro-next && npm run test --workspace=@flyo/nitro-next-playground",
    "test": "npm run ci-test",
    "lint": "npm run lint --workspaces",
    "prepare": "husky"
  },
  "lint-staged": {
    "playground/**/*.{js,jsx,ts,tsx}": [
      "npm run lint --workspace=playground"
    ],
    "lib/**/*.{js,jsx,ts,tsx}": [
      "npm run lint --workspace=lib"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@flyo/nitro-js-bridge": "^1.5.0",
    "@flyo/nitro-typescript": "^1.5.0"
  }
}

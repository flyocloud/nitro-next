{
  "name": "@flyo/nitro-next",
  "version": "2.8.3",
  "description": "Connecting Flyo Headless Content Hub into your Next.js project.",
  "homepage": "https://dev.flyo.cloud/nitro",
  "keywords": [
    "nextjs",
    "flyo",
    "cms",
    "headless"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src *.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "import": "./dist/proxy.mjs",
      "require": "./dist/proxy.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@flyo/nitro-js-bridge": "^1.5.0",
    "@flyo/nitro-typescript": "^1.7.0"
  },
  "peerDependencies": {
    "next": ">=16.0.4",
    "react": ">=19.2.0",
    "react-dom": ">=19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.4.12",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3"
  },
  "author": "Basil Suter <git@nadar.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flyocloud/nitro-next"
  },
  "publishConfig": {
    "access": "public"
  }
}
